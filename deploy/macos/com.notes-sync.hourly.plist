<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>NOTES_SYNC_LOG_DIR</key>
		<string>{{LOG_DIR}}</string>
		<key>PYTHONPATH</key>
		<string>{{PROJECT_ROOT}}/src</string>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>com.notes-sync.hourly</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{PROJECT_ROOT}}/.venv/bin/python</string>
		<string>-m</string>
		<string>notes_sync.cli</string>
		<string>run</string>
		<string>--config</string>
		<string>{{PROJECT_ROOT}}/params/default.json</string>
	</array>
	<key>StandardErrorPath</key>
	<string>{{LOG_DIR}}/hourly.log</string>
	<key>StandardOutPath</key>
	<string>{{LOG_DIR}}/hourly.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>WorkingDirectory</key>
	<string>{{PROJECT_ROOT}}</string>
</dict>
</plist>
