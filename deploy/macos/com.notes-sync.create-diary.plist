<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.notes-sync.create-diary</string>
        <key>ProgramArguments</key>
        <array>
            <string>{{PROJECT_ROOT}}/.venv/bin/python</string>
            <string>-m</string>
            <string>notes_sync.cli</string>
            <string>create-diary</string>
            <string>--config</string>
            <string>{{PROJECT_ROOT}}/params/default.json</string>
        </array>
        <key>WorkingDirectory</key>
        <string>{{PROJECT_ROOT}}</string>
        <key>EnvironmentVariables</key>
        <dict>
            <key>PYTHONPATH</key>
            <string>{{PROJECT_ROOT}}/src</string>
        </dict>
        <key>StartCalendarInterval</key>
        <dict>
            <key>Hour</key>
            <integer>0</integer>
            <key>Minute</key>
            <integer>5</integer>
        </dict>
        <key>KeepAlive</key>
        <dict>
            <key>SuccessfulExit</key>
            <false />
        </dict>
        <key>ThrottleInterval</key>
        <integer>60</integer>
        <key>StandardOutPath</key>
        <string>{{PROJECT_ROOT}}/output/create-diary.log</string>
        <key>StandardErrorPath</key>
        <string>{{PROJECT_ROOT}}/output/create-diary.log</string>
    </dict>
</plist>
