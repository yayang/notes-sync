# Antigravity Sync Engine - Configuration
# Rename this file to .env and fill in your values.

# --- Secrets (Required) ---
TOGGL_API_TOKEN=your_toggl_api_token_here
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# --- Paths (Required) ---
# Absolute path to your Obsidian Vault
OBSIDIAN_VAULT_PATH=/Users/yourname/Documents/ObsidianVault

# File Format: one "YYYY-MM-DD,steps" record per line
STEPS_DATA_FILE="path/to/health_data.txt"

# Constants
DATE_ICON_BASE_URL=https://cdn.jsdelivr.net/gh/
EARLIEST_SYNC_DATE=2025-12-14
